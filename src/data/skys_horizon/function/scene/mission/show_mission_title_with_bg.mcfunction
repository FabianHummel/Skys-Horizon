title @s reset

title @s times 0 3s 3s

$title @s title [{\
    text: "\uE000",\
    font: "skys_horizon:solid_color",\
    shadow_color: 0,\
    color: "black"\
}, {\
    text: "$(title)",\
    font: "skys_horizon:spectral",\
    shadow_color: 0,\
    color: "white"\
}]

$title @s subtitle {\
    text: "$(subtitle)",\
    font: "skys_horizon:spectral",\
    shadow_color: 0\
}
