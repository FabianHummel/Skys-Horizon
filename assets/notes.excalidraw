      "isDeleted": false,
      "boundElements": [],
      "updated": 1782760390549,
      "link": null,
      "locked": false,
      "text": "tick:\nprev-progress-direction = progress-direction\n\nlooking at interaction entity?\n  ✅ progress-direction = +1\n  ❌ progress-direction = -1\n\nprogress += progress-direction\nprogress >= 0\nprogress <= progress-fade-duration\n\nprogress = progress-fade-duration: /return run tag add hold_full\nprogress = 0: /return run tag add hold_none\nprogress-direction > prev-progress-direction: /tag add increasing\nprogress-direction < prev-progress-direction: /tag add decreasing",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "tick:\nprev-progress-direction = progress-direction\n\nlooking at interaction entity?\n  ✅ progress-direction = +1\n  ❌ progress-direction = -1\n\nprogress += progress-direction\nprogress >= 0\nprogress <= progress-fade-duration\n\nprogress = progress-fade-duration: /return run tag add hold_full\nprogress = 0: /return run tag add hold_none\nprogress-direction > prev-progress-direction: /tag add increasing\nprogress-direction < prev-progress-direction: /tag add decreasing",
      "autoResize": true,
      "lineHeight": 1.25
    },
