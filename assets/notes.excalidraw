      "isDeleted": false,
      "boundElements": [],
      "updated": 1779198162501,
      "link": null,
      "locked": false,
      "text": "if duration = 0 -> time / duration = 1 ",
      "fontSize": 10.832415225771804,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
