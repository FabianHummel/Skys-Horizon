{
    "name": "Sky's Horizon",
    "author": "Fabian Hummel",
    "ignore": [
        "instance"
    ],
    "data_pack": {
        "name": "Sky's Horizon",
        "load": [
            "include/animated_java-datapack",
            "include/find_looking",
            "include/generate_uuid",
            "include/gibbsly_math",
            "src"
        ]
    },
    "resource_pack": {
        "name": "Sky's Horizon",
        "load": [
            "include/animated_java-resourcepack",
            "include/nameless's_low-poly-guns",
            "include/debug_text",
            "include/objmc-rs",
            "src"
        ]
    },
    "require": [
        "plugins.done_message",
        "plugins.objmc-rs",
        "plugins.marker_color",
        "plugins.dialog",
        "plugins.aseprite",
        "plugins.doc_convert",
        "bookshelf.module.raycast",
        "include.callback_scheduler"
    ],
    "pipeline": [
        "beet.contrib.log_level",
        "beet.contrib.livereload",
        "plugins.inline_function_declaration",
        "plugins.generate_auto_called_nested_functions",
        "plugins.inline_function_declaration"
    ],
    "meta": {
        "objmc": {
            "binary": "include/objmc-rs/target/release/objmc-rs",
            "models": {
                "skys_horizon:space/planet/sorax4b": 249,
                "skys_horizon:entity/phoenix": 238
            }
        },
        "doc_convert": {
            "tool": "msword"
        },
        "log_level": {
            "level": "INFO"
        }
    }
